{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/348900b8b79f4a434cab4c74b3bc8d4d2fa8ee74/cli/schemas/config-file.v1.json",
  "lock": false,
  "imports": {
    "@tensorflow/tfjs": "https://esm.sh/@tensorflow/tfjs@4.15.0",
    "jpeg-js": "https://esm.sh/jpeg-js@0.4.4",
    "nsfwjs": "https://esm.sh/nsfwjs@2.4.2",
    "string-similarity": "npm:string-similarity@4.0.4"
  },
  "compilerOptions": {
    "noImplicitAny": false,
    "strict": false,
    "types": [],
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns",
      "deno.worker",
      "deno.unstable",
      "es2015",
      "es2016",
      "es2017",
      "es2018",
      "es2019",
      "es2020",
      "es2021",
      "es2022"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "node_modules_dir": false,
  "experimental": {
    "unstable-node-globals": true,
    "unstable-temporal": true,
    "unstable-worker-options": true,
    "unstable-sloppy-imports": true
  }
}